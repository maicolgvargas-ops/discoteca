			<Item class="ModuleScript" referent="RBX2">
				<Properties>
					<string name="Name">Catalog</string>
					<ProtectedString name="Source"><![CDATA[--[[
	CATALOGO DE BEBIDAS Y PRODUCTOS (modulo compartido servidor/cliente).

	* Las bebidas son OBJETOS VIRTUALES cosmeticos: no afectan a estadisticas, no hay azar.
	* Las botellas y copas son geometria ORIGINAL hecha por codigo (DrinkModels.luau) con el nombre
	  escrito como texto. No se usa ningun logo ni asset externo.
	* Los nombres de marcas conocidas (Don Julio 1942, Clase Azul, Patrón, Moët, Veuve Clicquot, Dom
	  Pérignon) los ha pedido el titular del proyecto como texto de ejemplo. Son marcas registradas
	  de terceros: revisa permisos y politicas de Roblox antes de publicar, o pon UseGenericNames = true
	  (o cambia los Name) para usar nombres genericos.

	COMO CAMBIAR EL CATALOGO: edita/añade filas en Items (Id unico, Tier "bottle" o "shot", Kind = tipo
	de modelo de DrinkModels) y, si quieres otros precios o productos, en Products.

	ROBUX: ver Products. ProductId = 0 significa "sin enlazar": esa compra queda DESACTIVADA. El
	precio mostrado al jugador es el real que devuelve MarketplaceService:GetProductInfoAsync; las cifras
	DraftRobux son un BORRADOR interno (400 botella / 50 shot) y no se muestran como precio real.
]]

local Catalog = {}

Catalog.UseGenericNames = false

Catalog.Categories = { "Champaña", "Tequila", "Whisky", "Shots" }

-- Tiers: cuantos "sorbos" tiene cada unidad. Los vales (vouchers) se canjean por articulos del mismo tier.
Catalog.Tiers = {
	bottle = { Label = "Botella", Servings = 5 },
	shot = { Label = "Copa / shot", Servings = 1 },
}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Style: colores de cristal, liquido, etiqueta, texto de etiqueta, capsula/tapon y acento.
Catalog.Items = {
	{
		Id = "champana_moet", Category = "Champaña", Tier = "bottle", Kind = "champagne",
		Name = "Moët & Chandon Impérial", GenericName = "Champán Imperial",
		Label = { "MOËT & CHANDON", "IMPÉRIAL", "BRUT" },
		Description = "Champán brut en botella verde oscura con capsula dorada.",
		Style = { glass = rgb(30, 58, 38), liquid = rgb(232, 206, 120), label = rgb(240, 236, 224), text = rgb(30, 30, 34), foil = rgb(205, 165, 72), accent = rgb(205, 165, 72) },
	},
	{
		Id = "champana_veuve", Category = "Champaña", Tier = "bottle", Kind = "champagne",
		Name = "Veuve Clicquot Brut", GenericName = "Champán Brut Etiqueta Amarilla",
		Label = { "VEUVE CLICQUOT", "BRUT" },
		Description = "Champán brut con etiqueta amarilla anaranjada.",
		Style = { glass = rgb(34, 54, 36), liquid = rgb(232, 206, 120), label = rgb(240, 176, 24), text = rgb(40, 28, 10), foil = rgb(240, 176, 24), accent = rgb(240, 176, 24) },
	},
	{
		Id = "champana_dom", Category = "Champaña", Tier = "bottle", Kind = "champagne",
		Name = "Dom Pérignon Vintage", GenericName = "Champán Vintage",
		Label = { "DOM PÉRIGNON", "VINTAGE" },
		Description = "Champán de añada en botella casi negra con etiqueta sobria.",
		Style = { glass = rgb(16, 24, 20), liquid = rgb(232, 206, 120), label = rgb(236, 230, 214), text = rgb(24, 24, 28), foil = rgb(26, 26, 30), accent = rgb(205, 165, 72) },
	},
	{
		Id = "tequila_donjulio", Category = "Tequila", Tier = "bottle", Kind = "flask",
		Name = "Don Julio 1942", GenericName = "Tequila Añejo 1942",
		Label = { "DON JULIO", "1942", "AÑEJO" },
		Description = "Tequila añejo en botella achaparrada de hombros planos y tapon de corcho.",
		Style = { glass = rgb(214, 226, 222), liquid = rgb(208, 142, 58), label = rgb(236, 224, 196), text = rgb(60, 36, 16), foil = rgb(196, 150, 66), accent = rgb(196, 150, 66) },
	},
	{
		Id = "tequila_claseazul", Category = "Tequila", Tier = "bottle", Kind = "round",
		Name = "Clase Azul Reposado", GenericName = "Tequila Reposado Azul",
		Label = { "CLASE AZUL", "REPOSADO" },
		Description = "Tequila reposado en botella redondeada blanca con bandas azules y tapon alto.",
		Style = { glass = rgb(238, 240, 246), liquid = rgb(214, 160, 76), label = rgb(34, 74, 170), text = rgb(244, 244, 250), foil = rgb(206, 208, 214), accent = rgb(34, 74, 170) },
	},
	{
		Id = "tequila_patron", Category = "Tequila", Tier = "bottle", Kind = "square",
		Name = "Patrón Silver", GenericName = "Tequila Silver",
		Label = { "PATRÓN", "SILVER" },
		Description = "Tequila blanco en botella cuadrada de cristal transparente con corcho.",
		Style = { glass = rgb(206, 224, 222), liquid = rgb(222, 236, 232), label = rgb(244, 244, 240), text = rgb(24, 70, 40), foil = rgb(120, 82, 46), accent = rgb(24, 70, 40) },
	},
	{
		Id = "whisky_reserva", Category = "Whisky", Tier = "bottle", Kind = "whisky",
		Name = "Whisky Reserva 12", GenericName = "Whisky Reserva 12",
		Label = { "WHISKY", "RESERVA", "12 AÑOS" },
		Description = "Whisky ambar de la casa en botella alta con tapon de corcho.",
		Style = { glass = rgb(210, 220, 214), liquid = rgb(196, 112, 28), label = rgb(232, 220, 190), text = rgb(48, 28, 12), foil = rgb(86, 56, 30), accent = rgb(176, 126, 52) },
	},
	{
		Id = "whisky_malta", Category = "Whisky", Tier = "bottle", Kind = "whisky",
		Name = "Single Malt 18", GenericName = "Single Malt 18",
		Label = { "SINGLE MALT", "18 AÑOS" },
		Description = "Whisky de malta añejo, ambar oscuro, etiqueta negra y dorada.",
		Style = { glass = rgb(200, 210, 204), liquid = rgb(150, 76, 20), label = rgb(24, 24, 28), text = rgb(222, 178, 90), foil = rgb(20, 20, 22), accent = rgb(222, 178, 90) },
	},
	{
		Id = "shot_tequila", Category = "Shots", Tier = "shot", Kind = "shot",
		Name = "Shot de tequila con lima", GenericName = "Shot de tequila con lima",
		Label = { "TEQUILA" },
		Description = "Chupito de tequila con una cuña de lima en el borde.",
		Style = { glass = rgb(214, 228, 232), liquid = rgb(236, 220, 150), label = rgb(236, 224, 196), text = rgb(40, 40, 40), foil = rgb(90, 160, 40), accent = rgb(90, 160, 40) },
	},
	{
		Id = "copa_champana", Category = "Shots", Tier = "shot", Kind = "flute",
		Name = "Copa de champaña", GenericName = "Copa de champán",
		Label = { "CHAMPAÑA" },
		Description = "Copa alta con champán y burbujas.",
		Style = { glass = rgb(214, 228, 240), liquid = rgb(236, 214, 130), label = rgb(236, 224, 196), text = rgb(40, 40, 40), foil = rgb(205, 165, 72), accent = rgb(205, 165, 72) },
	},
	{
		Id = "whisky_hielo", Category = "Shots", Tier = "shot", Kind = "tumbler",
		Name = "Whisky con hielo", GenericName = "Whisky con hielo",
		Label = { "WHISKY" },
		Description = "Vaso corto con whisky y dos cubos de hielo.",
		Style = { glass = rgb(214, 228, 240), liquid = rgb(196, 112, 28), label = rgb(236, 224, 196), text = rgb(40, 40, 40), foil = rgb(205, 165, 72), accent = rgb(205, 165, 72) },
	},
}

-- PRODUCTOS DE ROBUX (Developer Products). Una compra concede VALES; el jugador los canjea por el
-- articulo que quiera de ese tier. Se puede repetir sin limite.
--   ProductId = 0  -> sin enlazar: la compra con Robux de este producto esta DESACTIVADA.
--   DraftRobux     -> BORRADOR (no es un precio real; no se muestra como tal). El precio real se
--                     fija en el panel de Creator Hub al crear el producto.
-- Para enlazar: crea el Developer Product en Creator Hub, copia su ID aqui. Para productos futuros
-- (otro tipo de compra) añade una fila con Grant y, si hace falta, registra un manejador propio con
-- Purchases.registerHandler(productId, fn).
Catalog.Products = {
	{ Key = "vale_botella", ProductId = 0, Title = "Vale de botella", DraftRobux = 400, Grant = { vouchers = { bottle = 1 } } },
	{ Key = "vale_shot", ProductId = 0, Title = "Vale de shot / copa", DraftRobux = 50, Grant = { vouchers = { shot = 1 } } },
}

local itemById = {}
for _, item in Catalog.Items do
	itemById[item.Id] = item
end

function Catalog.getItem(id)
	if type(id) ~= "string" then
		return nil
	end
	return itemById[id]
end

function Catalog.displayName(item)
	if Catalog.UseGenericNames and item.GenericName then
		return item.GenericName
	end
	return item.Name
end

function Catalog.itemsByCategory(cat)
	local out = {}
	for _, item in Catalog.Items do
		if item.Category == cat then
			table.insert(out, item)
		end
	end
	return out
end

function Catalog.servings(item)
	return Catalog.Tiers[item.Tier].Servings
end

-- producto que concede un unico vale del tier (el que se ofrece al comprar un articulo de ese tier)
function Catalog.productForTier(tier)
	for _, p in Catalog.Products do
		local v = p.Grant and p.Grant.vouchers
		if v and v[tier] == 1 then
			local only = true
			for k in v do
				if k ~= tier then
					only = false
				end
			end
			if only and not p.Grant.items then
				return p
			end
		end
	end
	return nil
end

function Catalog.productById(productId)
	if type(productId) ~= "number" or productId == 0 then
		return nil
	end
	for _, p in Catalog.Products do
		if p.ProductId == productId then
			return p
		end
	end
	return nil
end

-- comprueba el catalogo: devuelve una lista de problemas (vacia = correcto)
function Catalog.validate()
	local problems = {}
	local seen = {}
	for _, item in Catalog.Items do
		if type(item.Id) ~= "string" or item.Id == "" then
			table.insert(problems, "articulo sin Id")
		elseif seen[item.Id] then
			table.insert(problems, "Id repetido: " .. item.Id)
		end
		seen[item.Id] = true
		if not Catalog.Tiers[item.Tier] then
			table.insert(problems, item.Id .. ": tier desconocido " .. tostring(item.Tier))
		end
		if not table.find(Catalog.Categories, item.Category) then
			table.insert(problems, item.Id .. ": categoria desconocida " .. tostring(item.Category))
		end
		if type(item.Name) ~= "string" or item.Name == "" then
			table.insert(problems, item.Id .. ": sin Name")
		end
		if type(item.Label) ~= "table" or #item.Label == 0 then
			table.insert(problems, item.Id .. ": sin Label (texto de la etiqueta)")
		end
	end
	local ids = {}
	for _, p in Catalog.Products do
		if type(p.ProductId) ~= "number" or p.ProductId < 0 then
			table.insert(problems, p.Key .. ": ProductId invalido")
		elseif p.ProductId ~= 0 then
			if ids[p.ProductId] then
				table.insert(problems, "ProductId repetido: " .. p.ProductId)
			end
			ids[p.ProductId] = true
		end
		for tier in (p.Grant and p.Grant.vouchers) or {} do
			if not Catalog.Tiers[tier] then
				table.insert(problems, p.Key .. ": concede un tier desconocido " .. tostring(tier))
			end
		end
		for id in (p.Grant and p.Grant.items) or {} do
			if not itemById[id] then
				table.insert(problems, p.Key .. ": concede un articulo desconocido " .. tostring(id))
			end
		end
	end
	for tier in Catalog.Tiers do
		if not Catalog.productForTier(tier) then
			table.insert(problems, "no hay producto de 1 vale para el tier " .. tier)
		end
	end
	return problems
end

return Catalog
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX3">
				<Properties>
					<string name="Name">Config</string>
					<ProtectedString name="Source"><![CDATA[--[[
	LA ALFOMBRA ROJA v2 - CONFIGURACION (modulo compartido servidor/cliente).

	Todo lo que puedes tocar sin leer el resto del codigo esta aqui. El catalogo de bebidas y los
	ProductIds estan en Catalog.luau. Nada de lo secreto o de seguridad se lee del cliente: el
	servidor valida siempre contra estas tablas.
]]

local Config = {
	Name = "LaAlfombraRoja",
	Version = "2.0.0",

	-- PERFIL GRAFICO: "Equilibrado" (por defecto, prioriza fluidez) o "Alta". Solo cambia lo que se
	-- construye y cuanto trabajo hacen las animaciones locales: NO toca la calidad grafica del jugador
	-- ni UserGameSettings/RenderSettings.
	Quality = "Equilibrado",
	TileCount = 0, -- 0 = segun el perfil (12 en Equilibrado, 16 en Alta)
	LowPerformance = false,
	Boundary = true, -- barrera invisible sobre el muro perimetral
	RemoveTemplateObjects = true, -- borra Baseplate/SpawnLocation de la plantilla

	-- OPCIONAL. Imagen del logo YA SUBIDA a tu cuenta ("rbxassetid://123", "123" o 123). Vacio = logo
	-- hecho con piezas y texto. Nunca se inventa un ID.
	LogoImageId = "",

	-- AJUSTES DE LUCES Y RENDER
	Look = {
		LightIntensity = 1.0,
		AmbientBoost = 1.0,
		Exposure = 0.5,
		Bloom = { Intensity = 0.3, Size = 18, Threshold = 1.0 },
		BeamTransparency = 0.0,
		BeamBrightness = 1.0,
		BeamWidth = 1.0,
		ShaftTransparency = 0.0,
		TileBrightness = 0.7,
		KeyShadows = true,
		Reflections = 1.0,
		ShadowSoftness = 0.35,
	},

	-- CABINA (luces + musica): UN solo operador a la vez. Access: "Todos" | "Lista" | "Dueno".
	-- "Dueno" = el creador del lugar (en Studio se permite siempre para poder probar).
	Control = {
		Enabled = true,
		Access = "Todos",
		UserIds = {}, -- con "Lista": { 123456, 789012 }
		GroupId = 0, -- 0 = sin grupo; si no, MinRank = rango minimo
		MinRank = 1,
		Range = 14, -- studs para tomar el control (se mantiene hasta 3x)
		IdleTimeout = 180,
		MaxRequestsPerSecond = 8,
	},

	-- MUSICA. Solo se reproducen las pistas de esta lista (lista blanca). Un cliente NUNCA puede
	-- mandar un assetId. Vacia por defecto: no hay ningun audio inventado. Para anadir uno:
	--   { Id = "rbxassetid://TU_ID", Title = "Titulo", Artist = "Artista" }
	-- El audio debe ser tuyo o tener permiso de uso en tu experiencia (los audios de terceros pueden
	-- no sonar si no los has subido tu o no son de la libreria publica).
	Music = {
		Enabled = true,
		Tracks = {},
		Volume = 0.5, -- volumen inicial 0..1 (se multiplica por MaxVolume)
		MaxVolume = 4, -- Sound.Volume al 100 % (Roblox admite hasta 10)
		VolumeStep = 0.1,
		Autoplay = false, -- true: empieza sola la primera pista al arrancar (si hay pistas)
		AutoNext = true, -- al terminar una pista pasa a la siguiente
		RollOffMin = 20,
		RollOffMax = 160,
	},

	-- TIENDA / INVENTARIO
	Shop = {
		Enabled = true,
		Range = 30, -- studs maximos desde un punto de venta (bartender / barra) para comprar o canjear
		MaxQty = 10, -- cantidad maxima por operacion
		MaxRequestsPerSecond = 6,
	},
	Data = {
		StoreName = "AlfombraRoja_Inventory_v2",
		AutosaveSeconds = 60,
		Retries = 4,
		MaxReceipts = 300, -- PurchaseIds recordados por jugador
	},

	-- COMPRAS CON ROBUX (Developer Products). Los ProductIds estan en Catalog.luau y valen 0 por
	-- defecto: con 0 NO se puede comprar nada con Robux. El precio que se muestra es el real que
	-- devuelve MarketplaceService; los precios del catalogo son BORRADOR y nunca se enseñan como reales.
	Purchases = {
		-- MODO DE PRUEBA EN STUDIO: concede los articulos GRATIS, sin Robux. Solo funciona si
		-- RunService:IsStudio() es verdadero (aunque lo dejes en true en produccion NO hace nada).
		StudioTestMode = false,
		PromptTimeout = 120, -- segundos que se recuerda una seleccion pendiente
	},

	-- SEGURIDAD DE LA ENTRADA. La "credencial" es un carnet FICTICIO del club (no es un documento,
	-- no pide datos reales y NO verifica la edad: la edad y la clasificacion las gestiona Roblox).
	Guards = {
		Enabled = true,
		BlockedUserIds = {}, -- jugadores a los que la seguridad no deja pasar
		SpawnOutside = true, -- con guardias, el spawn queda en la acera, delante de la puerta
		Range = 14,
		MaxRequestsPerSecond = 3,
		Lines = {
			Greeting = "Buenas noches. Para pasar a LA ALFOMBRA ROJA necesito ver tu credencial del club.",
			Granted = "Todo en orden. Adelante, bienvenido a LA ALFOMBRA ROJA.",
			Denied = "Lo siento, esta noche no puedo dejarte pasar.",
			Already = "Ya tienes acceso. Pasa cuando quieras.",
			Disclaimer = "Credencial ficticia del club. No es un documento oficial ni comprueba la edad: eso lo gestiona Roblox.",
		},
	},

	Seats = { Enabled = true, PromptDistance = 7, Cooldown = 0.6 },

	-- BAILE. Procedural y local por defecto (no hacen falta animaciones). AnimationId es OPCIONAL y
	-- vacio por defecto: si pones un id de animacion que tengas permiso de usar, se reproduce esa en vez de
	-- la procedural. Access: "Todos" o "Lista" (UserIds de Control.UserIds).
	Dance = {
		Enabled = true,
		MaxAnimateDistance = 80,
		MaxVisible = 12,
		MaxRequestsPerSecond = 3,
		Dances = {
			{ Id = "suave", Name = "Balanceo suave", AnimationId = "", Access = "Todos" },
			{ Id = "disco", Name = "Disco clásico", AnimationId = "", Access = "Todos" },
			{ Id = "rebote", Name = "Rebote", AnimationId = "", Access = "Todos" },
			{ Id = "ola", Name = "Ola de brazos", AnimationId = "", Access = "Todos" },
			{ Id = "lateral", Name = "Paso lateral", AnimationId = "", Access = "Todos" },
		},
	},

	-- NPC decorativos (bartenders, guardias, bailarinas): se animan en el cliente y solo cerca.
	Npcs = { Enabled = true, AnimateDistance = 90, MaxAnimated = 14, Dancers = 4 },

	-- CHAT: se usa SOLO el TextChatService oficial de Roblox (con su filtro). No se crea ningun chat
	-- propio. Si la cuenta del jugador no puede chatear, no se intenta evitarlo.
	Chat = { Enable = true },
}

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX4">
				<Properties>
					<string name="Name">DancePoses</string>
					<ProtectedString name="Source"><![CDATA[--[[
	DANCEPOSES - bailes PROCEDURALES (sin ids de animacion) para personajes R6 y R15.
	Se aplican en el CLIENTE cambiando Motor6D.C0 (no se replican: cada cliente anima a quien baila).

	DancePoses.new(model)              -> estado (o nil si no hay articulaciones conocidas)
	DancePoses.apply(state, id, t, w)  -> aplica el baile `id` en el instante t con peso w (0..1)
	DancePoses.reset(state)            -> restaura los C0 originales
	DancePoses.IDS                     -> ids de los bailes

	Los giros se expresan en el sistema del padre de la articulacion (X derecha, Y arriba, -Z delante):
	rx > 0 balancea el brazo/pierna hacia delante, rz > 0 separa el brazo derecho hacia fuera
	(el izquierdo usa -rz). Todos son bailes de discoteca normales y suaves.
]]

local DancePoses = {}

DancePoses.IDS = { "suave", "disco", "rebote", "ola", "lateral" }

-- nombres de Motor6D por tipo de rig
local MAP = {
	R6 = {
		root = "RootJoint", neck = "Neck", shR = "Right Shoulder", shL = "Left Shoulder", hipR = "Right Hip", hipL = "Left Hip",
	},
	R15 = {
		root = "Root", waist = "Waist", neck = "Neck", shR = "RightShoulder", shL = "LeftShoulder", elR = "RightElbow", elL = "LeftElbow",
		hipR = "RightHip", hipL = "LeftHip", kneeR = "RightKnee", kneeL = "LeftKnee",
	},
}

function DancePoses.new(model)
	local byName = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") then
			byName[d.Name] = d
		end
	end
	local rigType = (byName["RootJoint"] and byName["Right Shoulder"]) and "R6" or ((byName["Root"] and byName["RightShoulder"]) and "R15" or nil)
	if not rigType then
		return nil
	end
	local state = { model = model, rig = rigType, joints = {} }
	for key, name in MAP[rigType] do
		local m = byName[name]
		if m then
			state.joints[key] = { motor = m, base = m.C0 }
		end
	end
	return state
end

local sin, abs, max = math.sin, math.abs, math.max

-- devuelve { joint = { rx, ry, rz, dx, dy } } para el baile id en el instante t
local function pose(id, t, rig)
	local p = {}
	if id == "guardia" then
		-- de pie, brazos recogidos al frente, respiracion lenta (NPC, no seleccionable por jugadores)
		local b = t * 1.2
		p.root = { dy = 0.012 * sin(b), ry = 0.05 * sin(b * 0.4) }
		p.shR = { rz = 0.12, rx = 0.25 }
		p.shL = { rz = -0.12, rx = 0.25 }
		p.elR = { rx = -0.9 }
		p.elL = { rx = -0.9 }
		p.neck = { ry = 0.35 * sin(b * 0.35) }
	elseif id == "barra" then
		-- bartender: movimiento tranquilo de manos como si preparase una copa
		local b = t * 1.6
		p.root = { ry = 0.1 * sin(b * 0.5), dy = 0.01 * sin(b) }
		p.shR = { rx = 0.5 + 0.25 * sin(b), rz = 0.2 }
		p.shL = { rx = 0.5 + 0.25 * sin(b + 2.2), rz = -0.2 }
		p.elR = { rx = -0.7 + 0.2 * sin(b) }
		p.elL = { rx = -0.7 + 0.2 * sin(b + 2.2) }
		p.neck = { ry = 0.2 * sin(b * 0.4), rx = 0.1 }
	elseif id == "disco" then
		local b = t * 4
		p.root = { dy = 0.07 * abs(sin(b)), ry = 0.12 * sin(b * 0.5) }
		p.shR = { rz = 1.0 + 1.0 * max(0, sin(b)), rx = 0.1 }
		p.shL = { rz = -(1.0 + 1.0 * max(0, sin(b + math.pi))), rx = 0.1 }
		p.hipR = { rx = 0.25 * sin(b) }
		p.hipL = { rx = -0.25 * sin(b) }
		p.elR = { rx = -0.4 }
		p.elL = { rx = -0.4 }
		p.neck = { ry = 0.15 * sin(b * 0.5) }
	elseif id == "rebote" then
		local b = t * 5
		p.root = { dy = 0.18 * abs(sin(b)) }
		p.shR = { rx = 0.7 * sin(b), rz = 0.25 }
		p.shL = { rx = -0.7 * sin(b), rz = -0.25 }
		p.hipR = { rx = 0.2 * abs(sin(b)) }
		p.hipL = { rx = 0.2 * abs(sin(b)) }
		p.kneeR = { rx = -0.5 * abs(sin(b)) }
		p.kneeL = { rx = -0.5 * abs(sin(b)) }
		p.elR = { rx = -0.6 }
		p.elL = { rx = -0.6 }
	elseif id == "ola" then
		local b = t * 3
		p.root = { ry = 0.2 * sin(b * 0.5), dy = 0.03 * sin(b) }
		p.shR = { rz = 1.7 + 0.5 * sin(b), rx = 0.1 }
		p.shL = { rz = -(1.7 + 0.5 * sin(b - 1.2)), rx = 0.1 }
		p.elR = { rx = -0.5 * (1 + sin(b)) * 0.5 }
		p.elL = { rx = -0.5 * (1 + sin(b - 1.2)) * 0.5 }
		p.neck = { rz = 0.1 * sin(b * 0.5) }
	elseif id == "lateral" then
		local b = t * 2.5
		p.root = { dx = 0.4 * sin(b), dy = 0.04 * abs(sin(b * 2)), rz = 0.06 * sin(b) }
		p.hipR = { rz = 0.18 * max(0, sin(b)), rx = 0.05 }
		p.hipL = { rz = -0.18 * max(0, -sin(b)), rx = 0.05 }
		p.shR = { rx = 0.35 * sin(b), rz = 0.35 }
		p.shL = { rx = 0.35 * sin(b + math.pi), rz = -0.35 }
		p.elR = { rx = -0.7 }
		p.elL = { rx = -0.7 }
	else -- "suave"
		local b = t * 2
		p.root = { ry = 0.16 * sin(b), rz = 0.05 * sin(b), dy = 0.025 * abs(sin(b)) }
		p.shR = { rz = 0.45 + 0.18 * sin(b), rx = 0.1 * sin(b) }
		p.shL = { rz = -(0.45 + 0.18 * sin(b + math.pi)), rx = 0.1 * sin(b + math.pi) }
		p.elR = { rx = -0.35 }
		p.elL = { rx = -0.35 }
		p.neck = { ry = -0.1 * sin(b) }
	end
	if rig == "R6" then
		-- sin codos ni rodillas ni cintura: los brazos hacen todo el trabajo
		p.elR, p.elL, p.kneeR, p.kneeL, p.waist = nil, nil, nil, nil, nil
	end
	return p
end

local function composed(base, r, w)
	local pos = base.Position
	local rotOnly = CFrame.new(-pos.X, -pos.Y, -pos.Z) * base
	local c = CFrame.new(pos.X, pos.Y, pos.Z) * CFrame.Angles((r.rx or 0) * w, (r.ry or 0) * w, (r.rz or 0) * w) * rotOnly
	if r.dx or r.dy then
		c = CFrame.new((r.dx or 0) * w, (r.dy or 0) * w, 0) * c
	end
	return c
end

function DancePoses.apply(state, id, t, w)
	if not state then
		return
	end
	local p = pose(id, t, state.rig)
	for key, j in state.joints do
		local r = p[key]
		if r then
			j.motor.C0 = composed(j.base, r, w)
		else
			j.motor.C0 = j.base
		end
	end
end

function DancePoses.reset(state)
	if not state then
		return
	end
	for _, j in state.joints do
		j.motor.C0 = j.base
	end
end

-- id valido de baile (para validar peticiones)
function DancePoses.isValid(id)
	return type(id) == "string" and table.find(DancePoses.IDS, id) ~= nil
end

return DancePoses
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX5">
				<Properties>
					<string name="Name">DrinkModels</string>
					<ProtectedString name="Source"><![CDATA[--[[
	DRINKMODELS - botellas, copas y vasos 3D ORIGINALES hechos solo con geometria (Parts) y texto.
	Ningun logo, textura ni asset externo: cada etiqueta es una placa con un SurfaceGui de texto.

	DrinkModels.build(item, opts)  -> Model  (Handle invisible en el centro + piezas soldadas)
	    opts.parent    : donde colgar el modelo
	    opts.cframe    : CFrame de la BASE (centro del fondo) - por defecto el origen
	    opts.scale     : escala (1 = tamaño de exhibicion/vista previa; 0.55 en la mano)
	    opts.tool      : true -> piezas sin anclar, Massless, soldadas al Handle
	    opts.level     : 0..1 nivel inicial del liquido (1 = lleno)
	    opts.noLabels  : true -> sin SurfaceGui (vista previa en ViewportFrame, que no los dibuja)
	DrinkModels.makeTool(item, servingsLeft) -> Tool con Handle y atributos ItemId / Servings
	DrinkModels.setLevel(model, frac)        -> baja/sube el liquido (Weld.C0 + Size del liquido)
	DrinkModels.height(item, scale)          -> altura aproximada para encuadrar la camara
]]

local Catalog = require(script.Parent.Catalog)

local DrinkModels = {}

local function px(v, s)
	return math.max(v * s, 0.05)
end

-- Contexto de construccion: crea piezas en coordenadas locales (sin escalar) respecto a la base.
local function newContext(item, opts)
	local s = opts.scale or 1
	local base = opts.cframe or CFrame.new(0, 0, 0)
	local ctx = { s = s, base = base, parts = {}, liquids = {}, st = item.Style, item = item }
	ctx.model = Instance.new("Model")
	ctx.model.Name = item.Id
	local anchored = not opts.tool

	local function mk(name, cf, size, color, material, props)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = anchored
		p.CanCollide = false
		p.CastShadow = false
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if opts.tool then
			p.Massless = true
		end
		if props then
			for k, v in props do
				p[k] = v
			end
		end
		p.Parent = ctx.model
		table.insert(ctx.parts, p)
		return p
	end

	function ctx.box(name, lx, ly, lz, sx, sy, sz, color, material, props)
		return mk(name, base * CFrame.new(lx * s, ly * s, lz * s), Vector3.new(px(sx, s), px(sy, s), px(sz, s)), color, material, props)
	end
	function ctx.cyl(name, lx, ly, lz, h, d, color, material, props)
		local p = props or {}
		p.Shape = Enum.PartType.Cylinder
		return mk(name, base * CFrame.new(lx * s, ly * s, lz * s) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(px(h, s), px(d, s), px(d, s)), color, material, p)
	end
	function ctx.ball(name, lx, ly, lz, d, color, material, props)
		local p = props or {}
		p.Shape = Enum.PartType.Ball
		return mk(name, base * CFrame.new(lx * s, ly * s, lz * s), Vector3.new(px(d, s), px(d, s), px(d, s)), color, material, p)
	end
	function ctx.wedge(name, lx, ly, lz, sx, sy, sz, color, material, props)
		local p = Instance.new("WedgePart")
		p.Name = name
		p.Anchored = anchored
		p.CanCollide = false
		p.CastShadow = false
		p.Size = Vector3.new(px(sx, s), px(sy, s), px(sz, s))
		p.CFrame = base * CFrame.new(lx * s, ly * s, lz * s)
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		if opts.tool then
			p.Massless = true
		end
		if props then
			for k, v in props do
				p[k] = v
			end
		end
		p.Parent = ctx.model
		table.insert(ctx.parts, p)
		return p
	end
	-- liquido: cilindro vertical cuya altura se puede cambiar con setLevel
	function ctx.liquid(name, lx, bottomY, lz, fullH, d, color, transparency)
		local level = opts.level or 1
		local h = math.max(fullH * level, 0.05)
		local p = ctx.cyl(name, lx, bottomY + h / 2, lz, h, d, color, Enum.Material.SmoothPlastic, { Transparency = transparency or 0.2, Reflectance = 0.05 })
		p:SetAttribute("FullH", fullH)
		p:SetAttribute("BottomY", bottomY)
		p:SetAttribute("LX", lx)
		p:SetAttribute("LZ", lz)
		p:SetAttribute("Diam", d)
		table.insert(ctx.liquids, p)
		return p
	end
	-- etiqueta: placa (cara frontal = -Z) con lineas de texto legibles
	function ctx.label(name, lx, ly, lz, w, h, color, textColor, lines, fonts)
		local plate = ctx.box(name, lx, ly, lz, w, h, 0.04, color, Enum.Material.SmoothPlastic, { Reflectance = 0.05 })
		if opts.noLabels then
			return plate
		end
		local gui = Instance.new("SurfaceGui")
		gui.Name = "LabelGui"
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = math.clamp(160 / math.max(w * s, 0.05), 8, 500)
		gui.LightInfluence = 1
		gui.Parent = plate
		local n = #lines
		local y = 0.06
		local weights = { 0.42, 0.3, 0.22 }
		local total = 0
		for i = 1, n do
			total += weights[math.min(i, 3)]
		end
		for i, text in lines do
			local frac = weights[math.min(i, 3)] / total * 0.88
			local tl = Instance.new("TextLabel")
			tl.Name = "Line" .. i
			tl.BackgroundTransparency = 1
			tl.Position = UDim2.fromScale(0.05, y)
			tl.Size = UDim2.fromScale(0.9, frac)
			tl.Text = text
			tl.TextScaled = true
			tl.Font = (fonts and fonts[i]) or ((i == 1) and Enum.Font.GothamBold or Enum.Font.Garamond)
			tl.TextColor3 = textColor
			tl.Parent = gui
			y += frac
		end
		return plate
	end
	return ctx
end

local KINDS = {}

-- cuerpo de cristal con liquido interior
local function glassBody(ctx, h, d, y0, glassTransparency)
	local st = ctx.st
	return ctx.cyl("Body", 0, y0 + h / 2, 0, h, d, st.glass, Enum.Material.Glass, { Transparency = glassTransparency, Reflectance = 0.12 })
end

KINDS.champagne = function(ctx)
	local st = ctx.st
	ctx.cyl("Foot", 0, 0.05, 0, 0.1, 1.02, st.glass, Enum.Material.Glass, { Transparency = 0.1, Reflectance = 0.15 })
	glassBody(ctx, 2.0, 1.0, 0.1, 0.12)
	ctx.cyl("Shoulder1", 0, 2.25, 0, 0.3, 0.78, st.glass, Enum.Material.Glass, { Transparency = 0.12, Reflectance = 0.15 })
	ctx.cyl("Shoulder2", 0, 2.55, 0, 0.3, 0.58, st.glass, Enum.Material.Glass, { Transparency = 0.12, Reflectance = 0.15 })
	ctx.cyl("Neck", 0, 3.15, 0, 0.9, 0.42, st.glass, Enum.Material.Glass, { Transparency = 0.12, Reflectance = 0.15 })
	ctx.cyl("Foil", 0, 3.3, 0, 0.75, 0.5, st.foil, Enum.Material.Metal, { Reflectance = 0.35 })
	ctx.cyl("FoilTop", 0, 3.7, 0, 0.06, 0.52, st.foil, Enum.Material.Metal, { Reflectance = 0.35 })
	ctx.cyl("Cage", 0, 3.5, 0, 0.06, 0.56, st.accent, Enum.Material.Metal, { Reflectance = 0.5 })
	ctx.cyl("NeckBand", 0, 2.95, 0, 0.16, 0.46, st.accent, Enum.Material.Metal, { Reflectance = 0.4 })
	ctx.liquid("Liquid", 0, 0.14, 0, 1.9, 0.78, st.liquid, 0.55)
